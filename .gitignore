# Dependencies
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# Large Archive Files & Backups (CRITICAL: prevents uploading 9GB+ zip files)
*.zip
*.tar
*.tar.gz
*.rar
*.7z
server.zip
package-lock.zip

# Large Video & Media Files (GitHub has a strict 100MB file limit)
*.mp4
*.mkv
*.mov
*.avi
*.wmv
server/videos/*
!server/videos/.gitkeep

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env.*
server/.env
server/.env.*
!.env.example
!client/.env.example
!server/.env.example

# Production Build outputs
dist/
dist-ssr/
build/
client/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
.codex/
