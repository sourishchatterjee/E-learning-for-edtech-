# MongoDB Connection String (e.g. MongoDB Atlas free tier)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database-name>?retryWrites=true&w=majority

# JWT & Email Secrets
JWT_SECRET=your_jwt_secret_key_here
EMAIL_SECRET=your_email_secret_key_here
FRONTEND_URL=http://localhost:5173

# Server Environment & Port
NODE_ENV=development
HOST=localhost
PORT=3005
APP_NAME=SDLC_EdTech_LMS
API_FOLDER_NAME=api
USER_FOLDER_NAME=user
WEB_FOLDER_NAME=webservices
SHOW_NAMED_ROUTES=false

# Nodemailer / Email Service Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=your_email@gmail.com
